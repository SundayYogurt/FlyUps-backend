meta {
  name: Update Profile
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/user/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "first_name": "Test",
    "last_name": "User",
    "phone": "0812345678",
    "bio": "Hello I'm a pioneer",
    "faculty": "Engineering",
    "major": "Computer Science"
  }
}
