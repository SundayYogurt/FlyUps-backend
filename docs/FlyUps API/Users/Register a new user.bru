meta {
  name: Register a new user
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/SignUp
  body: json
  auth: inherit
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

example {
  name: 201 Response
  description: Success message
  
  request: {
    url: {{baseUrl}}/SignUp
    method: POST
    mode: none
  }
  
  response: {
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 400 Response
  description: Validation failed
  
  request: {
    url: {{baseUrl}}/SignUp
    method: POST
    mode: none
  }
  
  response: {
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 409 Response
  description: User already registered
  
  request: {
    url: {{baseUrl}}/SignUp
    method: POST
    mode: none
  }
  
  response: {
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 500 Response
  description: Internal Server Error
  
  request: {
    url: {{baseUrl}}/SignUp
    method: POST
    mode: none
  }
  
  response: {
    status: {
      code: 500
      text: Internal Server Error
    }
  
    body: {
      type: text
